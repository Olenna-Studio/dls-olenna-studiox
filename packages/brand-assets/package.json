{
  "name": "@olenna/brand-assets",
  "version": "2.0.0",
  "description": "Approved brand identity assets, logos, emblems, and usage metadata for Olenna StudioX",
  "keywords": [
    "olenna",
    "brand-assets",
    "design-system",
    "logos",
    "identity"
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./assets/*": "./src/assets/*",
    "./svg/*": "./src/assets/svg/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/assets"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "clean": "rm -rf dist",
    "lint": "eslint src/ --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
