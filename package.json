{
  "name": "olenna-studiox-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Olenna StudioX Design Language System (DLS)",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "build": "pnpm --filter \"@olenna/*\" run build",
    "build:tokens": "pnpm --filter @olenna/tokens run build",
    "build:packages": "pnpm --filter \"@olenna/*\" run build",
    "build:docs": "pnpm --filter docs run build",
    "build:storybook": "pnpm --filter @olenna/storybook run build",
    "build:examples": "pnpm --filter \"example-*\" run build",
    "dev": "pnpm --filter @olenna/storybook run storybook",
    "dev:docs": "pnpm --filter docs run dev",
    "dev:example-vite": "pnpm --filter example-vite-react run dev",
    "dev:example-next": "pnpm --filter example-nextjs run dev",
    "storybook": "pnpm --filter @olenna/storybook run storybook",
    "test": "pnpm --filter \"@olenna/*\" run test",
    "test:coverage": "pnpm --filter \"@olenna/*\" run test:coverage",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "clean": "pnpm -r run clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css}\"",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.12",
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
